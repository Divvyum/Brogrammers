# Copy to .env and fill in. Ask Divyam for the real values.
PORT=3000
FIREBASE_PROJECT_ID=brogramming-ae10d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local development: talk to the Firebase emulators. Remove both lines to use the real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Path to the Firebase service account JSON (only needed without emulators)
GOOGLE_APPLICATION_CREDENTIALS=

SUPERADMIN_EMAIL=
GEMINI_API_KEY=
GITHUB_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
WA_ENABLED=false
# Stable AES key used to encrypt the Baileys session in Firestore. Defaults to DATA_ENC_KEY.
WA_SESSION_KEY=
# Print the QR in the server terminal. Use only with a spare WhatsApp SIM.
WA_PRINT_QR=true
WA_WORKER_ID=

# Participant app URL (used in enrollment links)
PARTICIPANT_APP_URL=http://localhost:5174

# Generated by `pnpm keys`; don't write these by hand.
ORGANIZER_PRIVATE_PEM=
ORGANIZER_PUBLIC_RAW_B64U=
DATA_ENC_KEY=
HASH_KEY=

# Optional
# APP_CHECK_ENFORCE=true          production only
# JOBS_DISABLED=true              turn off cron jobs and the check-in listener
# REPLACEMENT_INVITE_MINUTES=120
# REBALANCE_GRACE_MINUTES=30

# Public base URL of the API (certificate links). Production: https://admin.yourdomain.in
PUBLIC_BASE_URL=http://localhost:3000
# Optional: Gemini models to try in order (first busy → next)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-latest
